  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dearest,\n\nThe <color=#C4831B><b><u>  ............  </u></b></color>
    has finally broken over the orchard, and I found myself thinking of you at the
    <color=#9E8D7A><u>............</u></color> hour. I still remember the way you
    <color=#9E8D7A><u>............</u></color> when Father spoke about the harvest.
    The house feels <color=#9E8D7A><u>............</u></color> without your footsteps
    on the stair.\n\nYesterday I walked out to the <color=#9E8D7A><u>............</u></color>
    and left a stone where we used to sit. I suppose that is a <color=#9E8D7A><u>............</u></color>
    thing to do. Write back when you can. I will be <color=#9E8D7A><u>............</u></color>
    until then.\n\n                                                       Ever yours,\n                                                      
    <color=#9E8D7A><u>............</u></color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e3415a25d2f252c418b7b4b31a195fc9, type: 2}
  m_sharedMaterial: {fileID: 4350130204539160935, guid: e3415a25d2f252c418b7b4b31a195fc9, type: 2}
